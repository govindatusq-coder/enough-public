# Supabase (public, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ENOUGH AI ideas (server-only)
OPENAI_API_KEY=

# Load Bear — server-only. Never expose through NEXT_PUBLIC_.
ANTHROPIC_API_KEY=            # enables photo / screenshot / PDF bill reading
BEAR_MODEL=claude-opus-5-5    # optional override
BEAR_VAPID_PUBLIC_KEY=        # npx web-push generate-vapid-keys
BEAR_VAPID_PRIVATE_KEY=
BEAR_VAPID_SUBJECT=mailto:you@example.com
BEAR_CRON_SECRET=             # bearer token for /api/bear/cron/reminders
SUPABASE_SERVICE_ROLE_KEY=    # used ONLY by the cron route to find push subscriptions

# Local development without Supabase: in-memory store for one local user (ignored when a
# Supabase URL is set or on Vercel).
# BEAR_DEV_STORE=memory
