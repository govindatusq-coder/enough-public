# OpenAI-compatible AI settings for Load Bear (template).
#
# NOTE: Load Bear does not read these yet. They take effect only once the "OpenAI option" is built into the app.
# Until then the app uses Claude (ANTHROPIC_API_KEY).
#
# Where they go: Vercel → your project → Settings → Environment Variables (Production).
# Never paste the API keys into a chat, an email or this file in the repository; put them only in Vercel.

# --- Chat (what Bear says back, and adding or changing tasks) ---
# The service's address. Either form works:
#   https://api.openai.com/v1
#   https://api.openai.com/v1/chat/completions
BEAR_OPENAI_BASE_URL=https://api.openai.com/v1
# The secret key from that service's account (starts with sk- on OpenAI).
BEAR_OPENAI_API_KEY=
# The model name the service uses, for example gpt-4o.
BEAR_OPENAI_MODEL=gpt-4o

# --- Reading photos, PDFs and emails (vision) ---
# Can be the same service as above or a different one. Same two address forms.
BEAR_VISION_BASE_URL=https://api.openai.com/v1
BEAR_VISION_API_KEY=
# A model that can read images, for example gpt-4o.
BEAR_VISION_MODEL=gpt-4o
