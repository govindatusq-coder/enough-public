{
  "expo": {
    "name": "Righto",
    "slug": "righto",
    "version": "0.1.0",
    "scheme": "righto",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F1"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Righto uses Face ID to keep your homework and notes private."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2746",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      ["expo-local-authentication", { "faceIDPermission": "Righto uses Face ID to keep your homework and notes private." }],
      ["expo-notifications", { "color": "#0F2746" }]
    ]
  }
}
